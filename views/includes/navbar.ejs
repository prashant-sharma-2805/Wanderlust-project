<style>
   .search-btn{
      background-color: #fe424d;
      color: #fff;
      display: flex;
      justify-content: center;
      border-radius: 25px;
   }
   .search-btn:hover{
      background-color: #fe424d;
      color: #fff;
   }

   .search-btn i{
    margin-top: 0.3rem;
    margin-right: 0.3rem;
   }

   .search-inp{
      border-radius: 25px;
      padding: 0.5rem 3rem 0.5rem 3rem;
   }

   .navBtn{
    margin-top: 0.45rem;
    background-color: #57B9FF;
    color: white;
    border: none;
    border-radius: 2rem;
    padding: 0.2rem 0.5rem 0.2rem 0.5rem;
   }


   .uploadListing{
    margin-right: 0.55rem;
    background-color: #fe424d;
    border-radius: 25px;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 2.5rem;
    padding-right: 1rem;
    margin-top: 0.55rem;
   }

   .plus-icon{
    font-size: 1.5rem;
    font-weight: 900;
    color: white;
   }

   .uploadListing p{
    color: white;
    margin-top: 0.85rem;
   }
   
</style>



<nav class="navbar navbar-expand-sm  bg-body-light border-bottom sticky-top">
  <div class="container-fluid main-navbar">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    

    <div class="navbar-nav  search-box">
        <form class="d-flex" role="search">
          <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations" />
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        </form>
      </div>

      <button class="navbar-toggler hamburger" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse " id="navbarNavAltMarkup">
      
       <div class="navbar-nav ms-auto">
      

          <a class="nav-link uploadListing" href="/listings/new"><i class="fa-solid fa-plus plus-icon"></i><p><b>Upload Listing</b></p></a>
          

        <% if(!currUser) {%>
        <a class="nav-link"  href="/signup"><button class="navBtn">Signup</button></a>
        <a class="nav-link" href="/login"><button class="navBtn">Login</button></a>
        <% } %>

        <% if(currUser) {%>
        <a class="nav-link" href="/logout"><button class="navBtn">Log out</button></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>